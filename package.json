{
  "name": "agentdex-town",
  "version": "0.18.1",
  "description": "A pixel town where your AI agents live, work, and ask before they act. Real Claude agents, YES/NO approvals, WhatsApp remote control.",
  "keywords": [
    "agent-dashboard",
    "ai-agents",
    "anthropic",
    "claude",
    "claude-code",
    "gba",
    "human-in-the-loop",
    "pixel-art",
    "whatsapp"
  ],
  "homepage": "https://github.com/ivanntongg/agentdex#readme",
  "bugs": {
    "url": "https://github.com/ivanntongg/agentdex/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivanntongg/agentdex.git"
  },
  "type": "module",
  "bin": {
    "agentdex-town": "bin/agentdex.js"
  },
  "files": [
    "bin/",
    "index.html",
    "server/*.js",
    "runtime/*.js",
    "runtime/fonts/",
    "bridges/*.js",
    "docs/icon.svg",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test server/test/*.test.js runtime/test/*.test.js bridges/test/*.test.js",
    "real": "node runtime/index.js --with-server",
    "agents": "node runtime/index.js"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "1.10.0"
  }
}
